# Stripe (checkout) — fill in when ready
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Shippo (shipping rates / labels) — fill in when ready
SHIPPO_API_TOKEN=

# Quote form (Cloudflare Pages Function → Resend)
# Free API key: https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives quote requests (Gmail is fine until domain mail is ready)
QUOTE_TO=thesoulflys@gmail.com
# Optional: after you verify thesoulflys.com in Resend, use e.g.
# QUOTE_FROM=The Soul Flys <booking@thesoulflys.com>
QUOTE_FROM=The Soul Flys <onboarding@resend.dev>
