---
interface Props {
  eyebrow: string;
  title: string;
  image: string;
  imageAlt?: string;
  /** CSS object-position for the hero crop (e.g. "center 20%") */
  imagePosition?: string;
}

const {
  eyebrow,
  title,
  image,
  imageAlt = '',
  imagePosition = 'center 40%',
} = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt={imageAlt} style={`object-position: ${imagePosition}`} />
    <div class="page-hero__veil"></div>
  </div>
  <div class="wrap page-hero__content">
    <p class="eyebrow animate-in">{eyebrow}</p>
    <h1 class="animate-in-delay">{title}</h1>
    <div class="page-hero__lead animate-in-delay-2">
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    min-height: clamp(18rem, 48vh, 28rem);
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: kenburns 18s ease-out both;
  }

  .page-hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 10, 9, 0.25) 0%, rgba(12, 10, 9, 0.55) 45%, rgba(12, 10, 9, 0.94) 100%),
      radial-gradient(ellipse at 65% 30%, rgba(232, 168, 58, 0.14), transparent 55%);
  }

  .page-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.5rem, 7vw, 4rem);
    max-width: 48rem;
  }

  .page-hero h1 {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    max-width: 18ch;
  }

  .page-hero__lead :global(p) {
    margin: 0 0 0.75em;
    max-width: 38rem;
    color: var(--fg-muted);
  }

  .page-hero__lead :global(p:last-child) {
    margin-bottom: 0;
  }

  .page-hero__lead :global(.lede) {
    font-size: 1.15rem;
    color: var(--fg);
  }
</style>
