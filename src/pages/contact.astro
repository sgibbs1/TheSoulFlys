---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band, socials } from '../data/band';
---

<BaseLayout
  title="Contact"
  description="Book The Soul Flys or get in touch for inquiries."
  path="/contact"
>
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow animate-in">Contact</p>
      <h1 class="animate-in-delay">Get in touch</h1>
      <p class="animate-in-delay-2">
        The Soul Flys create an unforgettable experience for your event. Reach
        out for bookings and inquiries.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap contact">
      <div>
        <p class="eyebrow">Booking</p>
        <h2>Call or text</h2>
        <a class="phone" href={band.phoneHref}>{band.phone}</a>
      </div>
      <div>
        <p class="eyebrow">Social</p>
        <h2>Follow the flys</h2>
        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  .phone {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--accent);
  }

  .phone:hover {
    color: var(--fg);
  }

  .socials {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .socials a {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
