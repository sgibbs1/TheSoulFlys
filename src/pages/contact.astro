---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { band, socials } from '../data/band';
---

<BaseLayout
  title="Contact"
  description="Book The Soul Flys or get in touch for inquiries."
  path="/contact"
>
  <PageHero
    eyebrow="Contact"
    title="Get in touch"
    image="/images/hero-contact.jpg"
    imageAlt="The Soul Flys on stage"
  >
    <p>
      {band.booking.intro} Reach out for bookings and inquiries.
    </p>
  </PageHero>

  <section class="section section--tight book-types">
    <div class="wrap">
      <p class="eyebrow">{band.booking.headline}</p>
      <h2>Book the flys</h2>
      <ul class="event-list">
        {band.booking.events.map((event) => <li>{event}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap contact">
      <div>
        <p class="eyebrow">Booking</p>
        <h2>Call or text</h2>
        <a class="phone" href={band.phoneHref}>{band.phone}</a>
      </div>
      <div>
        <p class="eyebrow">Social</p>
        <h2>Follow the flys</h2>
        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .book-types {
    border-bottom: 1px solid var(--line);
    background: var(--bg-elevated);
  }

  .event-list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .event-list li {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  .phone {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--accent);
  }

  .phone:hover {
    color: var(--fg);
  }

  .socials {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .socials a {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  @media (max-width: 700px) {
    .contact {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
