---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { calendar } from '../data/calendar';
---

<BaseLayout
  title="Shows"
  description="Upcoming shows for The Soul Flys — live schedule via Google Calendar."
  path="/shows"
>
  <PageHero
    eyebrow="Schedule"
    title={calendar.title}
    image="/images/hero-shows.jpg"
    imageAlt="The Soul Flys full band performing outdoors at a live set"
  >
    <p>{calendar.description}</p>
    <p class="tz">{calendar.timezoneNote}</p>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap">
      {
        calendar.isPlaceholder && (
          <p class="notice" role="status">
            Showing a placeholder calendar. Open{' '}
            <code>src/data/calendar.ts</code> and paste your public Google
            Calendar embed URL, then set <code>isPlaceholder</code> to{' '}
            <code>false</code>.
          </p>
        )
      }
      <div class="calendar-shell">
        <iframe
          src={calendar.embedUrl}
          title="The Soul Flys show calendar"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tz {
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }

  .notice {
    margin-bottom: 1.25rem;
    padding: 1rem 1.15rem;
    border: 1px solid rgba(232, 168, 58, 0.35);
    background: rgba(232, 168, 58, 0.08);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--fg);
  }

  code {
    color: var(--accent);
    font-size: 0.9em;
  }

  .calendar-shell {
    border: 1px solid var(--line);
    background: #fff;
    min-height: 70vh;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  .calendar-shell iframe {
    width: 100%;
    min-height: 70vh;
    height: 800px;
    border: 0;
  }
</style>
