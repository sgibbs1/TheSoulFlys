---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band } from '../data/band';
---

<BaseLayout path="/">
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img src="/images/hero-home.jpg" alt="" />
      <div class="hero__veil"></div>
    </div>
    <div class="wrap hero__content">
      <p class="eyebrow animate-in">{band.tagline}</p>
      <h1 class="animate-in-delay">{band.name}</h1>
      <p class="hero__lead animate-in-delay-2">
        {band.roots}. Immersive live shows from {band.location}.
      </p>
      <div class="cta-row animate-in-delay-2">
        <a class="btn" href="/shows">Upcoming Shows</a>
        <a class="btn btn--ghost" href="/gallery">Gallery</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose-block">
      <p class="eyebrow">{band.journey.headline}</p>
      <h2>Set the vibe. Feel the frequency.</h2>
      {band.journey.body.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section class="section award">
    <div class="wrap award__inner">
      <p class="eyebrow">Recognition</p>
      <h2>{band.award.title}</h2>
      <p>{band.award.detail}</p>
    </div>
  </section>

  <section class="section section--tight photo-feature">
    <div class="wrap photo-feature__grid">
      <figure class="photo-feature__shot">
        <img
          src="/images/home-live.jpg"
          alt="The Soul Flys full band performing live"
          loading="lazy"
        />
      </figure>
      <div class="photo-feature__copy">
        <p class="eyebrow">Live</p>
        <h2>Come see us</h2>
        <p>
          Witness the raw energy of The Soul Flys — dynamic stage presence and a
          funky-fun signature sound from intimate rooms to larger venues.
        </p>
        <div class="cta-row">
          <a class="btn" href="/shows">View Schedule</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight photo-feature photo-feature--flip">
    <div class="wrap photo-feature__grid">
      <figure class="photo-feature__shot">
        <img
          src="/images/home-vocals.jpg"
          alt="The Soul Flys full band performing live under purple stage lights"
          loading="lazy"
        />
      </figure>
      <div class="photo-feature__copy">
        <p class="eyebrow">Sound</p>
        <h2>Soulful nights</h2>
        <p>
          With Cheryl Christmas&rsquo;s powerful, authentically soulful vocals at
          the forefront, the band blends psychedelic soul and funk rock into a
          smooth, contagious vibe.
        </p>
        <div class="cta-row">
          <a class="btn btn--ghost" href="/about">Meet the Band</a>
          <a class="btn btn--ghost" href="/gallery">See More Photos</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section book-home">
    <div class="wrap book-home__inner">
      <p class="eyebrow">{band.booking.headline}</p>
      <h2>Weddings · corporate · festivals · bars</h2>
      <p>
        From intimate celebrations to big outdoor stages, The Soul Flys bring the
        fun frequency wherever the night takes them.
      </p>
      <div class="cta-row">
        <a class="btn" href="/contact">Book the Band</a>
        <a class="btn btn--ghost" href={band.phoneHref}>Call {band.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-h));
    display: grid;
    align-items: end;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    animation: kenburns 18s ease-out both;
  }

  /* Phone: keep the lead singer centered; desktop crop unchanged */
  @media (max-width: 720px) {
    .hero__media img {
      object-position: 16% 40%;
    }
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(12, 10, 9, 0.35) 0%, rgba(12, 10, 9, 0.55) 40%, rgba(12, 10, 9, 0.96) 100%),
      radial-gradient(ellipse at 70% 30%, rgba(232, 168, 58, 0.18), transparent 55%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(3rem, 10vw, 5.5rem);
    padding-top: 4rem;
    max-width: 52rem;
  }

  .hero__lead {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    max-width: 34rem;
    color: var(--fg);
  }

  .prose-block {
    max-width: 42rem;
  }

  .award {
    background:
      linear-gradient(120deg, rgba(232, 168, 58, 0.12), transparent 55%),
      var(--bg-elevated);
    border-block: 1px solid var(--line);
  }

  .award__inner {
    max-width: 40rem;
  }

  .photo-feature__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
  }

  .photo-feature--flip .photo-feature__grid {
    grid-template-columns: 1fr 1.15fr;
  }

  .photo-feature--flip .photo-feature__shot {
    order: 2;
  }

  .photo-feature--flip .photo-feature__copy {
    order: 1;
  }

  .photo-feature__shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .photo-feature__shot img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .photo-feature__shot:hover img {
    transform: scale(1.03);
  }

  .book-home {
    border-top: 1px solid var(--line);
    background:
      linear-gradient(120deg, rgba(232, 168, 58, 0.1), transparent 55%),
      var(--bg-elevated);
  }

  .book-home__inner {
    max-width: 40rem;
  }

  @media (max-width: 780px) {
    .photo-feature__grid,
    .photo-feature--flip .photo-feature__grid {
      grid-template-columns: 1fr;
    }

    .photo-feature--flip .photo-feature__shot,
    .photo-feature--flip .photo-feature__copy {
      order: unset;
    }
  }
</style>
