---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { band } from '../data/band';
---

<BaseLayout
  title="About"
  description={`About ${band.name} — ${band.about.headline}`}
  path="/about"
>
  <PageHero
    eyebrow="About"
    title={band.about.headline}
    image="/images/hero-about.jpg"
    imageAlt="The Soul Flys performing live as a full band"
  >
    <p class="lede">{band.about.intro}</p>
    <p>{band.about.motto}</p>
  </PageHero>

  <section class="section section--tight accent-band">
    <div class="wrap narrow">
      <h2>{band.about.leftOfCenter.title}</h2>
      <p>{band.about.leftOfCenter.body}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Meet The Soul Flys</p>
      <h2>Our musical souls</h2>
      <p class="intro">
        A collective of groove-driven players who breathe funk and soul into
        every jam. Each of us brings a unique flair and raw self-expression to
        the stage.
      </p>
      <ul class="members">
        {
          band.members.map((member) => (
            <li class="member">
              <div class="member__who">
                <h3>{member.name}</h3>
                <p class="member__role">{member.role}</p>
              </div>
              <p class="member__blurb">{member.blurb}</p>
              <ul class="member__details">
                {member.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 40rem;
  }

  .accent-band {
    background: var(--bg-elevated);
    border-block: 1px solid var(--line);
  }

  .intro {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .member {
    display: grid;
    grid-template-columns: minmax(11rem, 0.85fr) minmax(0, 1.6fr) minmax(8rem, 0.9fr);
    gap: 1rem 1.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .member__who h3 {
    margin: 0 0 0.35rem;
    font-size: 1.7rem;
  }

  .member__role {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .member__blurb {
    margin: 0;
    max-width: 36rem;
    color: var(--fg);
  }

  .member__details {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  @media (max-width: 780px) {
    .member {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }
</style>
