---
import BaseLayout from '../layouts/BaseLayout.astro';
import { band } from '../data/band';
---

<BaseLayout
  title="About"
  description={`About ${band.name} — ${band.about.headline}`}
  path="/about"
>
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow animate-in">About</p>
      <h1 class="animate-in-delay">{band.about.headline}</h1>
      <p class="lede animate-in-delay-2">{band.about.intro}</p>
      <p class="animate-in-delay-2">{band.about.motto}</p>
    </div>
  </section>

  <section class="section section--tight accent-band">
    <div class="wrap narrow">
      <h2>{band.about.leftOfCenter.title}</h2>
      <p>{band.about.leftOfCenter.body}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Meet The Soul Flys</p>
      <h2>Our musical souls</h2>
      <p class="intro">
        A collective of passionate players who breathe funk and soul into every
        jam. Each member brings a unique flair and honest self-expression to the
        stage.
      </p>
      <ul class="members">
        {
          band.members.map((member) => (
            <li class="member">
              <h3>{member.name}</h3>
              <p class="member__role">{member.role}</p>
              <ul class="member__details">
                {member.details.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero h1 {
    max-width: 16ch;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--fg);
    max-width: 40rem;
  }

  .narrow {
    max-width: 40rem;
  }

  .accent-band {
    background: var(--bg-elevated);
    border-block: 1px solid var(--line);
  }

  .intro {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .member {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(8rem, 0.7fr) 1.4fr;
    gap: 1rem 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .member h3 {
    margin: 0;
    font-size: 1.7rem;
  }

  .member__role {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .member__details {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--fg-muted);
  }

  @media (max-width: 780px) {
    .member {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
