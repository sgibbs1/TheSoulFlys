---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { merch, formatPrice } from '../data/merch';
---

<BaseLayout
  title="Merch"
  description="Official The Soul Flys t-shirts — $25 each."
  path="/merch"
>
  <PageHero
    eyebrow="Merch"
    title="Wear the frequency"
    image="/images/home-live.jpg"
    imageAlt="The Soul Flys full band performing live under green stage lights"
    imagePosition="center 18%"
  >
    <p>
      Wear the vibe. Take a piece of the music home with you with official gear
      from The Soul Flys. From soft graphic tees to custom accessories, this is
      your chance to represent the community and look good doing it.
    </p>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap">
      <div class="merch-grid">
        {
          merch.products.map((product) => (
            <article class="merch-item" data-product-id={product.id}>
              <figure class="merch-item__shot">
                <img
                  src={product.image}
                  alt={product.imageAlt}
                  loading="lazy"
                  width="800"
                  height="800"
                />
              </figure>
              <div class="merch-item__copy">
                <h2>{product.name}</h2>
                <p class="merch-item__price">{formatPrice(product.priceCents)}</p>
                <p>{product.description}</p>
                <button
                  class="btn"
                  type="button"
                  disabled={!merch.checkoutReady}
                  data-checkout={product.id}
                >
                  {merch.checkoutReady ? 'Buy' : 'Checkout soon'}
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .merch-grid {
    display: grid;
    gap: 3rem 2rem;
  }

  .merch-item {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .merch-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .merch-item:nth-child(even) .merch-item__shot {
    order: 2;
    justify-self: end;
  }

  .merch-item__shot {
    margin: 0;
    width: fit-content;
    max-width: 100%;
    justify-self: start;
    overflow: hidden;
  }

  .merch-item__shot img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 20rem;
    display: block;
  }

  .merch-item__copy h2 {
    margin-bottom: 0.35em;
  }

  .merch-item__price {
    margin: 0 0 0.85rem;
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .merch-item__copy .btn {
    margin-top: 1.25rem;
  }

  .merch-item__copy .btn:disabled {
    opacity: 0.55;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 780px) {
    .merch-item {
      grid-template-columns: 1fr;
    }

    .merch-item__shot,
    .merch-item:nth-child(even) .merch-item__shot {
      order: unset;
      justify-self: center;
    }
  }
</style>
