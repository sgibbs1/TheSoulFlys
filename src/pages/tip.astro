---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { tips } from '../data/tips';
---

<BaseLayout
  title="Tip the Band"
  description="Send a tip to The Soul Flys via Venmo."
  path="/tip"
>
  <PageHero
    eyebrow="Support"
    title={tips.headline}
    image="/images/hero-contact.jpg"
    imageAlt="The Soul Flys on stage"
  >
    <p>{tips.intro}</p>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap tip-grid">
      {
        tips.methods.map((method) => (
          <article class="tip-method tip-method--live">
            <p class="eyebrow">Live now</p>
            <h2>{method.label}</h2>
            <p>{method.note}</p>
            {method.qrImage && (
              <figure class="tip-qr">
                <img
                  src={method.qrImage}
                  alt={method.qrAlt ?? `${method.label} QR code`}
                  width="480"
                  height="560"
                />
              </figure>
            )}
            {method.href && (
              <div class="cta-row">
                <a
                  class="btn"
                  href={method.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {method.cta ?? `Open ${method.label}`}
                </a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .tip-grid {
    display: grid;
    gap: 2.5rem;
    max-width: 28rem;
  }

  .tip-method--live {
    padding: 1.5rem 1.5rem 1.75rem;
    border: 1px solid var(--line);
    background:
      linear-gradient(160deg, rgba(232, 168, 58, 0.08), transparent 55%),
      var(--bg-elevated);
  }

  .tip-qr {
    margin: 1.5rem 0 0;
    max-width: 18rem;
    padding: 0.85rem;
    background: #fff;
  }

  .tip-qr img {
    width: 100%;
    height: auto;
  }
</style>
