---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleryItems, videoEmbedUrl } from '../data/gallery';
import type { GalleryVideo } from '../data/gallery';
---

<BaseLayout
  title="Gallery"
  description="Photos and videos from The Soul Flys live."
  path="/gallery"
>
  <section class="section page-hero">
    <div class="wrap">
      <p class="eyebrow animate-in">Gallery</p>
      <h1 class="animate-in-delay">Images &amp; video</h1>
      <p class="animate-in-delay-2">
        A look at the live energy. Swap placeholders for your photos and YouTube
        links in <code>src/data/gallery.ts</code>.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="gallery">
        {
          galleryItems.map((item) =>
            item.type === 'image' ? (
              <figure class="gallery__item gallery__item--image">
                <img src={item.src} alt={item.alt} loading="lazy" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ) : (
              <div class="gallery__item gallery__item--video">
                <div class="video-frame">
                  <iframe
                    src={videoEmbedUrl(item as GalleryVideo)}
                    title={(item as GalleryVideo).title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
                <p class="video-title">{(item as GalleryVideo).title}</p>
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  code {
    font-family: var(--font-ui);
    font-size: 0.85em;
    color: var(--accent);
  }

  .gallery {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(12, 1fr);
  }

  .gallery__item {
    margin: 0;
    grid-column: span 6;
    overflow: hidden;
  }

  .gallery__item--image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.55s ease;
  }

  .gallery__item--image:hover img {
    transform: scale(1.04);
  }

  figcaption,
  .video-title {
    margin-top: 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .gallery__item--video {
    grid-column: span 12;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--line);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 700px) {
    .gallery__item,
    .gallery__item--video {
      grid-column: span 12;
    }
  }
</style>
