---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { galleryItems, videoEmbedUrl } from '../data/gallery';
import type { GalleryImage, GalleryVideo } from '../data/gallery';
---

<BaseLayout
  title="Gallery"
  description="Photos and videos from The Soul Flys live."
  path="/gallery"
>
  <PageHero
    eyebrow="Gallery"
    title="Images & video"
    image="/gallery/g32.jpg"
    imageAlt="The Soul Flys full band performing live — all flys on deck"
  >
    <p>
      Step inside our world. From the heat of packed club stages to the energy of
      massive festival crowds, this is The Soul Flys in our element—no filters,
      just raw moments and pure groove.
    </p>
  </PageHero>

  <section class="section section--tight">
    <div class="wrap">
      <div class="gallery">
        {
          galleryItems.map((item) =>
            item.type === 'image' ? (
              <figure
                class:list={[
                  'gallery__item',
                  'gallery__item--image',
                  {
                    'gallery__item--zoom-out': (item as GalleryImage).zoomOut,
                    'gallery__item--zoom-in': (item as GalleryImage).zoomIn,
                    'gallery__item--half': (item as GalleryImage).half,
                  },
                ]}
              >
                <img src={item.src} alt={item.alt} loading="lazy" />
                {item.caption && <figcaption>{item.caption}</figcaption>}
              </figure>
            ) : (
              <div class="gallery__item gallery__item--video">
                <div class="video-frame">
                  <iframe
                    src={videoEmbedUrl(item as GalleryVideo)}
                    title={(item as GalleryVideo).title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  />
                </div>
                <p class="video-title">{(item as GalleryVideo).title}</p>
              </div>
            ),
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  code {
    font-family: var(--font-ui);
    font-size: 0.85em;
    color: var(--accent);
  }

  .gallery {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(12, 1fr);
  }

  .gallery__item {
    margin: 0;
    grid-column: span 6;
    overflow: hidden;
  }

  .gallery__item:nth-child(1):not(.gallery__item--zoom-out):not(.gallery__item--zoom-in),
  .gallery__item:nth-child(2):not(.gallery__item--zoom-out):not(.gallery__item--zoom-in) {
    grid-column: span 12;
  }

  .gallery__item--image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center center;
    background: #0a0807;
    transition: transform 0.55s ease;
  }

  .gallery__item:nth-child(1):not(.gallery__item--zoom-out):not(.gallery__item--zoom-in) img,
  .gallery__item:nth-child(2):not(.gallery__item--zoom-out):not(.gallery__item--zoom-in) img {
    aspect-ratio: 16 / 9;
  }

  /* Full photo visible — no forced crop */
  .gallery__item--zoom-out {
    grid-column: span 12;
  }

  .gallery__item--zoom-out.gallery__item--half {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
  }

  .gallery__item--zoom-out img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(92vh, 58rem);
    aspect-ratio: auto;
    object-fit: contain;
    object-position: center top;
    display: block;
    margin-inline: auto;
  }

  .gallery__item--zoom-out.gallery__item--half img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    max-height: none;
    object-fit: contain;
    object-position: center center;
    background: #0a0807;
  }

  /* Tight crop on the drummer */
  .gallery__item--zoom-in {
    grid-column: span 6;
  }

  .gallery__item--zoom-in img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center center;
  }

  .gallery__item--image:hover img {
    transform: scale(1.04);
  }

  figcaption,
  .video-title {
    margin-top: 0.65rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .gallery__item--video {
    grid-column: span 12;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1px solid var(--line);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 700px) {
    .gallery__item,
    .gallery__item--video,
    .gallery__item--zoom-out,
    .gallery__item--zoom-in {
      grid-column: span 12;
    }
  }
</style>
