---
import '../styles/global.css';
import { band, socials } from '../data/band';
import { nav } from '../data/nav';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = band.name,
  description = `${band.name} — ${band.tagline}. ${band.roots}.`,
  path = '/',
} = Astro.props;

const pageTitle = title === band.name ? title : `${title} | ${band.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site).toString()} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site).toString()} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="logo" href="/" aria-label={band.name}>
          <img src="/images/logo.png" alt={band.name} width="160" height="160" />
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="sr-only">Menu</span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-nav" data-nav>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <div>
          <p class="site-footer__brand">{band.name}</p>
          <p class="site-footer__tag">{band.tagline}</p>
        </div>
        <div class="site-footer__booking">
          <p class="eyebrow">Booking</p>
          <a href={band.phoneHref}>{band.phone}</a>
        </div>
        <ul class="social-list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener noreferrer">
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="wrap site-footer__copy">
        <p>&copy; {new Date().getFullYear()} {band.name}. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('[data-nav-toggle]');
      const nav = document.querySelector('[data-nav]');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('is-open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    background: var(--accent);
    color: #1a1208;
    padding: 0.6rem 1rem;
    z-index: 100;
    font-family: var(--font-ui);
    text-decoration: none;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--line);
    background: rgba(12, 10, 9, 0.88);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .logo img {
    display: block;
    height: 3.15rem;
    width: auto;
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .logo:hover img {
    transform: scale(1.04);
    filter: brightness(1.08);
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.4rem;
  }

  .site-nav a {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--accent);
  }

  .nav-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .nav-toggle span:not(.sr-only) {
    display: block;
    width: 1.1rem;
    height: 2px;
    margin: 0.28rem auto;
    background: var(--fg);
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2.5rem 0 1.5rem;
    background: var(--bg-elevated);
  }

  .site-footer__inner {
    display: grid;
    gap: 1.75rem;
    grid-template-columns: 1.4fr 1fr 1fr;
    align-items: start;
  }

  .site-footer__brand {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 0.25rem;
    color: var(--fg);
  }

  .site-footer__tag,
  .site-footer__copy p {
    margin: 0;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    color: var(--fg-muted);
  }

  .site-footer__booking a {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }

  .site-footer__booking a:hover {
    color: var(--accent);
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-list a {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-footer__copy {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 780px) {
    .nav-toggle {
      display: inline-block;
    }

    .site-nav {
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      background: rgba(12, 10, 9, 0.97);
      border-bottom: 1px solid var(--line);
      padding: 1rem var(--space) 1.25rem;
      display: none;
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0.85rem;
    }

    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
